# Option 1: Firebase Configuration (Real-time Cloud Database, Auth & Document Storage)
# Get these 6 keys from Firebase Console -> Project Settings -> General -> Your apps -> Web (</>)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Option 2: FastAPI Backend URL (If running python backend on Render / Railway)
VITE_API_URL=
