# =============================================================================
# DSA OS — Environment Configuration Example
# Copy to .env and fill in values for your environment.
# NEVER commit .env to version control.
# NEVER use real PAN, Aadhaar, bank account numbers, or real credentials here.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=CHANGE_ME_dev_secret_key_not_real

# --- Backend API ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dsaos
POSTGRES_USER=dsaos_migrator
POSTGRES_PASSWORD=CHANGE_ME_dev_pg_password
POSTGRES_APP_USER=dsaos_app
POSTGRES_APP_PASSWORD=CHANGE_ME_dev_app_pg_password
POSTGRES_READONLY_USER=dsaos_readonly
POSTGRES_READONLY_PASSWORD=CHANGE_ME_dev_readonly_pg_password

# Application-level DATABASE_URL (uses dsaos_app role)
DATABASE_URL=postgresql+asyncpg://dsaos_app:CHANGE_ME_dev_app_pg_password@localhost:5432/dsaos
# Migration DATABASE_URL (uses dsaos_migrator role)
DATABASE_MIGRATION_URL=postgresql+asyncpg://dsaos_migrator:CHANGE_ME_dev_pg_password@localhost:5432/dsaos

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_dev_redis_password
REDIS_URL=redis://:CHANGE_ME_dev_redis_password@localhost:6379/0

# --- MinIO / Object Storage ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME_minio_access_key
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key
MINIO_SECURE=false
MINIO_QUARANTINE_BUCKET=dsaos-quarantine
MINIO_CANONICAL_BUCKET=dsaos-canonical
MINIO_REGION=ap-south-1

# --- JWT / Authentication ---
# RS256 keys — generate with: openssl genrsa -out jwt_private.pem 2048
# Keep private key SECRET. Only public key may be shared.
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- ClamAV ---
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO

# --- Auth Rate Limiting ---
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
