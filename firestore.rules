rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // DSA OS — Multi-Tenant Vehicle Loan Operations
    // Permissive access for pilot prototyping across public referral intake and admin/telecaller workspaces
    match /cases/{caseId} {
      allow read, write: if true;
    }
    match /referral_profiles/{profileId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
