# =============================================================================
# DSA OS — .gitignore
# IMPORTANT: Never commit .env files containing real secrets
# =============================================================================

# --- Secrets & Environment ---
.env
.env.local
.env.*.local
*.pem
*.key
*.p12

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!frontend/src/shared/lib/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.pyc

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.coverage

# Mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff/Linting
.ruff_cache/

# --- Node / Frontend ---
node_modules/
frontend/node_modules/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build output
frontend/dist/
frontend/.vite/
.vite/
dist/

# --- Docker & Infrastructure ---
# (docker-compose.override.yml IS committed for dev convenience)
.docker-data/
postgres-data/
redis-data/
minio-data/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Keys (generated during dev setup) ---
backend/keys/

# --- Uploads / temp ---
uploads/
tmp/
temp/
